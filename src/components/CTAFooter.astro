---
import { ctaFooter } from '../data/content.js';
---

<footer id="contact">

  <!-- CTA section -->
  <section class="cta-section" aria-labelledby="cta-h">
    <div class="container cta-inner">
      <div class="cta-content reveal">

        <!-- Script label -->
        <p class="script-line" aria-hidden="true">Champion of Joy</p>

        <h2 class="cta-heading" id="cta-h">
          <span class="hl hl-thin" style="color:rgba(255,255,255,0.35)">
            {ctaFooter.heading.split(' ')[0]}
          </span>
          <span class="hl hl-heavy" style="color:#fff">
            {ctaFooter.heading.split(' ').slice(1).join(' ')}
          </span>
        </h2>

        <p class="cta-sub">{ctaFooter.subhead}</p>

        <div class="cta-btns">
          {ctaFooter.ctas.map(cta => (
            <a
              href={cta.href}
              class={`btn btn-${cta.variant}`}
            >
              {cta.label}
            </a>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Bottom bar -->
  <div class="bottom-bar">
    <div class="container bar-inner">
      <span class="copyright">{ctaFooter.copyright}</span>
      <span class="bar-script" aria-hidden="true">Champion of Joy</span>
    </div>
  </div>

</footer>

<style>
/* ── CTA section ─────────────────────────────────────────── */
.cta-section {
  background: var(--dark);
  padding-block: var(--sp-24);
  border-top: 1px solid var(--dark-border);
}

.cta-inner {
  /* Constrain content width for readability */
}

.cta-content {
  max-width: 800px;
  display: flex;
  flex-direction: column;
  gap: var(--sp-7);
}

/* Script decorative line */
.script-line {
  font-family: var(--script);
  font-size: clamp(1.875rem, 3.5vw, 2.75rem);
  color: var(--accent);
  line-height: 1.2;
}

/* Massive heading */
.cta-heading {
  font-size: clamp(3.5rem, 10vw, 7.5rem);
  letter-spacing: -0.045em;
  line-height: 1.0;
}

.cta-sub {
  font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
  color: rgba(255, 255, 255, 0.5);
  max-width: 480px;
  line-height: 1.75;
}

.cta-btns {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-3);
  padding-top: var(--sp-2);
}

/* ── Bottom bar ──────────────────────────────────────────── */
.bottom-bar {
  background: #100e09;
  padding-block: var(--sp-5);
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}

.bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-3);
}

.copyright {
  font-size: 0.8125rem;
  color: rgba(255, 255, 255, 0.22);
}

.bar-script {
  font-family: var(--script);
  font-size: 1.25rem;
  color: var(--accent);
  opacity: 0.5;
}
</style>
