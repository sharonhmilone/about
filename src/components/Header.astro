---
// Header: starts transparent over dark hero, frosts on scroll
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="wordmark" aria-label="Sharon Milone — home">Sharon</a>
    <nav aria-label="Primary navigation">
      <a href="#contact" class="header-cta">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding-block: var(--sp-5);
    /* Starts transparent — hero is dark so this blends in */
    background: transparent;
    transition: background 300ms ease, box-shadow 300ms ease;
  }

  .site-header.scrolled {
    background: rgba(24, 22, 15, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #fff;
    transition: color var(--ease);
  }

  .wordmark:hover { color: var(--color-accent); }

  .header-cta {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.3);
    padding: 0.4375rem 1.0625rem;
    border-radius: var(--radius-pill);
    transition: background var(--ease), border-color var(--ease);
  }

  .header-cta:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .header-cta:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
