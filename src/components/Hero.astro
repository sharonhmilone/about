---
import { hero } from '../data/content.js';
---

<section class="hero" aria-label="Introduction">
  <div class="container">

    <div class="hero-body">
      <!-- Script eyebrow -->
      <p class="hero-eyebrow reveal">
        <span class="script-label">{hero.eyebrow}</span>
      </p>

      <!-- Weight-contrast headline -->
      <h1 class="hero-headline reveal d1" aria-label={hero.headline}>
        <span class="hl hl-thin">Building what's next</span>
        <span class="hl hl-heavy">in content,</span>
        <span class="hl hl-accent">AI and tech.</span>
      </h1>

      <p class="hero-sub reveal d2">{hero.subhead}</p>

      <div class="hero-ctas reveal d3">
        {hero.ctas.map((cta) => (
          <a href={cta.href} class={`btn btn-${cta.variant}`}>{cta.label}</a>
        ))}
      </div>
    </div>

    <!-- Quote card — treated as a distinct visual object -->
    <blockquote class="hero-quote reveal d4" aria-label="Featured quote">
      <div class="quote-accent" aria-hidden="true"></div>
      <p class="quote-mark" aria-hidden="true">&ldquo;</p>
      <p class="quote-text">{hero.featuredQuote}</p>
    </blockquote>

  </div>

  <!-- Scroll cue, desktop only -->
  <div class="scroll-cue" aria-hidden="true">
    <span class="scroll-label">Scroll</span>
    <span class="scroll-line"></span>
  </div>
</section>

<style>
/* ── Section ─────────────────────────────────────────────── */
.hero {
  background: var(--dark);
  min-height: 100svh;
  padding-top: var(--sp-16);
  padding-bottom: var(--sp-20);
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* Warm radial glow — adds depth to dark bg */
.hero::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -10%;
  width: 70%;
  aspect-ratio: 1;
  background: radial-gradient(circle, rgba(139, 104, 48, 0.1) 0%, transparent 65%);
  pointer-events: none;
  z-index: 0;
}

.hero > .container { position: relative; z-index: 1; }

@media (min-width: 640px) {
  .hero {
    padding-top: var(--sp-20);
    padding-bottom: var(--sp-24);
  }
}

/* ── Hero body ───────────────────────────────────────────── */
.hero-body { max-width: 820px; }

/* ── Eyebrow ─────────────────────────────────────────────── */
.hero-eyebrow { margin-bottom: var(--sp-5); }

.script-label {
  display: inline-block;
  font-family: var(--script);
  font-size: clamp(1.875rem, 4.5vw, 2.75rem);
  font-weight: 400;
  color: var(--accent);
  line-height: 1.2;
  letter-spacing: 0;
}

/* ── Headline ────────────────────────────────────────────── */
.hero-headline {
  font-size: clamp(2.75rem, 9vw, 6.5rem);
  margin-bottom: var(--sp-8);
  color: #fff;
}

/* ── Subhead ─────────────────────────────────────────────── */
.hero-sub {
  font-size: clamp(1rem, 1.8vw, 1.1875rem);
  color: var(--dark-muted);
  max-width: 480px;
  line-height: 1.7;
  margin-bottom: var(--sp-10);
}

/* ── CTAs ────────────────────────────────────────────────── */
.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-3);
}

/* ── Quote card ──────────────────────────────────────────── */
.hero-quote {
  margin-top: var(--sp-16);
  display: grid;
  grid-template-columns: 4px 1fr;
  gap: 0 var(--sp-7);
  max-width: 560px;
  align-items: start;
}

@media (min-width: 640px) {
  .hero-quote { max-width: 600px; }
}

@media (min-width: 1024px) {
  /* On large screens, float the quote to the right of the body */
  .hero {
    container-type: inline-size;
  }
  .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: end;
  }
  .hero-body { max-width: none; }
  .hero-quote {
    margin-top: var(--sp-24);
    max-width: none;
  }
}

.quote-accent {
  width: 4px;
  background: var(--accent);
  border-radius: 2px;
  height: 100%;
  min-height: 60px;
}

.quote-mark {
  font-family: var(--serif);
  font-size: 3.5rem;
  line-height: 0.55;
  color: var(--accent);
  margin-bottom: var(--sp-3);
  user-select: none;
}

.quote-text {
  font-family: var(--serif);
  font-style: italic;
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.88);
}

/* ── Scroll cue ──────────────────────────────────────────── */
.scroll-cue {
  display: none;
  position: absolute;
  bottom: var(--sp-8);
  left: 50%;
  transform: translateX(-50%);
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
}

@media (min-width: 640px) { .scroll-cue { display: flex; } }

.scroll-label {
  font-size: 0.5625rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.18);
}

.scroll-line {
  display: block;
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.2), transparent);
  animation: scrollPulse 2.2s ease-in-out infinite;
}

@keyframes scrollPulse {
  0%, 100% { opacity: 0.4; transform: scaleY(1); }
  50%       { opacity: 1;   transform: scaleY(1.12); }
}

@media (prefers-reduced-motion: reduce) {
  .scroll-line { animation: none; }
}
</style>
