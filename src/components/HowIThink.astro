---
import { howIThink } from '../data/content.js';
---

<section class="section how-i-think" id="thinking" aria-labelledby="think-h">
  <div class="container">

    <header class="think-header reveal">
      <p class="eyebrow eyebrow-bronze">{howIThink.eyebrow}</p>
      <h2 class="s-heading" id="think-h">
        <span class="hl hl-thin">How I</span>
        <span class="hl hl-heavy">Think.</span>
      </h2>
    </header>

    <!-- Editorial staggered block list -->
    <ol class="principles" aria-label="Thinking principles">
      {howIThink.principles.map((p, i) => (
        <li
          class={`principle reveal d${(i % 4) + 1}`}
          aria-labelledby={`p-${i}`}
        >
          <span class="p-num" aria-hidden="true">{p.number}</span>
          <div class="p-body">
            <h3 class="p-title" id={`p-${i}`}>{p.title}</h3>
            <p class="p-text">{p.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- Pull quote — full-width rhythm break -->
    <blockquote class="pull-quote reveal" aria-label="Quote on AI">
      <p class="pq-text">{howIThink.pullQuote}</p>
    </blockquote>

  </div>
</section>

<style>
/* ── Section ─────────────────────────────────────────────── */
.how-i-think {
  background: var(--surface);
  border-top: 1px solid var(--border);
}

.think-header { margin-bottom: var(--sp-12); }

/* ─────────────────────────────────────────────────────────
   PRINCIPLES — mobile: stacked list with rule
   Tablet+: 2-col
   Desktop: 2-col staggered (right col offset)
───────────────────────────────────────────────────────── */
.principles {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  margin-bottom: var(--sp-16);
}

@media (min-width: 640px) {
  .principles {
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }
}

@media (min-width: 1024px) {
  /* Stagger: right column pushed down to break the grid rhythm */
  .principles {
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  /* Even children (02, 04) get a downward push */
  .principle:nth-child(even) {
    margin-top: var(--sp-10);
  }
}

/* ── Single principle ────────────────────────────────────── */
.principle {
  display: grid;
  grid-template-columns: 3rem 1fr;
  gap: var(--sp-5);
  align-items: start;
  padding-block: var(--sp-8);
  border-top: 1px solid var(--border);
  position: relative;
  transition: border-color var(--t);
}

.principle:last-child { border-bottom: 1px solid var(--border); }

@media (min-width: 640px) {
  .principle {
    grid-template-columns: 1fr;
    border-top: none;
    border-bottom: none;
    padding: var(--sp-8);
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .principle:last-child { border-bottom: 1px solid var(--border); }

  .principle:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 28px rgba(139, 104, 48, 0.08);
  }
}

/* ── Number ──────────────────────────────────────────────── */
.p-num {
  font-size: 0.6875rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  padding-top: 4px;
}

@media (min-width: 640px) {
  .p-num {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: rgba(139, 104, 48, 0.18);
    line-height: 1;
    margin-bottom: var(--sp-3);
  }
}

/* ── Body ────────────────────────────────────────────────── */
.p-body {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.p-title {
  font-size: clamp(1rem, 1.8vw, 1.125rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.3;
  color: var(--text);
}

.p-text {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* ── Pull quote ──────────────────────────────────────────── */
.pull-quote {
  padding-block: var(--sp-10);
  border-top: 1px solid var(--border);
  text-align: center;
}

.pq-text {
  font-family: var(--serif);
  font-style: italic;
  font-size: clamp(1.375rem, 3vw, 2.25rem);
  line-height: 1.4;
  color: var(--text);
  max-width: 660px;
  margin-inline: auto;
}

.pq-text::before { content: '\201C'; color: var(--accent); }
.pq-text::after  { content: '\201D'; color: var(--accent); }
</style>
