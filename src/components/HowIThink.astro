---
import { howIThink } from '../data/content.js';
---

<section class="section how-i-think" id="thinking" aria-labelledby="thinking-heading">
  <div class="container">

    <header class="section-header reveal">
      <p class="section-eyebrow">Approach</p>
      <h2 class="section-heading" id="thinking-heading">{howIThink.heading}</h2>
    </header>

    <div class="principles-grid">
      {howIThink.principles.map((p, i) => (
        <article
          class={`principle reveal reveal-delay-${i + 1}`}
          aria-labelledby={`principle-${i}`}
        >
          <span class="principle-num" aria-hidden="true">{p.number}</span>
          <h3 class="principle-title" id={`principle-${i}`}>{p.title}</h3>
          <p class="principle-body">{p.body}</p>
        </article>
      ))}
    </div>

    <blockquote class="pull-quote reveal" aria-label="Sharon Milone quote">
      <p class="pull-quote-text">{howIThink.pullQuote}</p>
    </blockquote>

  </div>
</section>

<style>
  .how-i-think {
    background: var(--color-bg);
  }

  .section-header {
    margin-bottom: var(--sp-12);
  }

  /* ── Principles grid ─────────────────────────────────────────── */
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-bottom: var(--sp-16);
  }

  @media (min-width: 640px) {
    .principles-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .principles-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .principle {
    padding: var(--sp-8);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: box-shadow var(--ease), transform var(--ease);
  }

  .principle:hover {
    box-shadow: 0 8px 32px rgba(28, 26, 23, 0.07);
    transform: translateY(-2px);
  }

  .principle-num {
    display: block;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--sp-4);
  }

  .principle-title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: var(--sp-3);
  }

  .principle-body {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* ── Pull quote ──────────────────────────────────────────────── */
  .pull-quote {
    text-align: center;
    padding: var(--sp-12) var(--sp-6);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pull-quote-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.35;
    color: var(--color-text);
    max-width: 720px;
    margin-inline: auto;
  }

  .pull-quote-text::before { content: '\201C'; color: var(--color-accent); }
  .pull-quote-text::after  { content: '\201D'; color: var(--color-accent); }
</style>
