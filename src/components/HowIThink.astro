---
import { howIThink } from '../data/content.js';
---

<section class="section how-i-think" id="thinking" aria-labelledby="thinking-heading">
  <div class="container">

    <header class="section-header reveal">
      <p class="section-eyebrow">Approach</p>
      <h2 class="section-heading" id="thinking-heading">
        <span class="hl hl-light">How I</span>
        <span class="hl hl-heavy">Think.</span>
      </h2>
    </header>

    <div class="principles-grid">
      {howIThink.principles.map((p, i) => (
        <article
          class={`principle reveal reveal-delay-${i + 1}`}
          aria-labelledby={`principle-${i}`}
        >
          <!-- Ghost number watermark -->
          <span class="ghost-num" aria-hidden="true">{p.number}</span>
          <div class="principle-inner">
            <span class="principle-label" aria-hidden="true">{p.number}</span>
            <h3 class="principle-title" id={`principle-${i}`}>{p.title}</h3>
            <p class="principle-body">{p.body}</p>
          </div>
        </article>
      ))}
    </div>

    <blockquote class="pull-quote reveal" aria-label="Sharon Milone on AI">
      <p class="pull-quote-text">{howIThink.pullQuote}</p>
    </blockquote>

  </div>
</section>

<style>
  .how-i-think {
    background: var(--color-surface);
  }

  .section-header {
    margin-bottom: var(--sp-12);
  }

  /* ── Principles grid ─────────────────────────────────────────── */
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
    margin-bottom: var(--sp-16);
  }

  @media (min-width: 640px) {
    .principles-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 1024px) {
    .principles-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── Single principle ────────────────────────────────────────── */
  .principle {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: box-shadow var(--ease), transform var(--ease), border-color var(--ease);
  }

  .principle:hover {
    box-shadow: 0 10px 36px rgba(28,26,23,0.08);
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }

  /* Ghost background number */
  .ghost-num {
    position: absolute;
    bottom: -0.2em;
    right: -0.05em;
    font-size: 7rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--color-text);
    opacity: 0.04;
    user-select: none;
    pointer-events: none;
    transition: opacity var(--ease);
  }

  .principle:hover .ghost-num { opacity: 0.06; }

  .principle-inner {
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    position: relative;
    z-index: 1;
  }

  .principle-label {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .principle-title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-text);
  }

  .principle-body {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* ── Pull quote ──────────────────────────────────────────────── */
  .pull-quote {
    text-align: center;
    padding-block: var(--sp-12);
    border-top: 1px solid var(--color-border);
  }

  .pull-quote-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.35;
    color: var(--color-text);
    max-width: 700px;
    margin-inline: auto;
  }

  .pull-quote-text::before { content: '\201C'; color: var(--color-accent-mid); }
  .pull-quote-text::after  { content: '\201D'; color: var(--color-accent-mid); }
</style>
