---
import { proofBand } from '../data/content.js';
---

<section class="proof-band" aria-label="Credentials and working style">
  <div class="container">

    <!-- Logo row -->
    <p class="band-label reveal">Featured in and built for</p>
    <div
      class="logo-row h-scroll reveal d1"
      role="list"
      aria-label="Organizations worked with"
    >
      {proofBand.logos.map((logo) => (
        <div class="logo-item" role="listitem">
          <span class="logo-name">{logo.name}</span>
        </div>
      ))}
    </div>

    <div class="rule band-rule reveal d2"></div>

    <!-- Chips -->
    <p class="band-label reveal d2">How I work</p>
    <div
      class="chip-row h-scroll reveal d3"
      role="list"
      aria-label="Working style"
    >
      {proofBand.chips.map((chip, i) => (
        <span class={`chip ${i === 0 ? 'chip--on' : ''}`} role="listitem">
          {chip}
        </span>
      ))}
    </div>

  </div>
</section>

<style>
/* ── Section ─────────────────────────────────────────────── */
.proof-band {
  background: var(--cream);
  padding-block: var(--sp-12);
  border-bottom: 1px solid var(--border);
}

/* ── Label ───────────────────────────────────────────────── */
.band-label {
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: var(--sp-4);
}

/* ── Logo row ────────────────────────────────────────────── */
.logo-row {
  /* Bleed to screen edges on mobile for scrollable feel */
  margin-inline: calc(-1 * var(--sp-6));
  padding-inline: var(--sp-6);
  padding-bottom: var(--sp-1);
  gap: var(--sp-3);
}

@media (min-width: 640px) {
  .logo-row {
    margin-inline: 0;
    padding-inline: 0;
    flex-wrap: wrap;
    overflow-x: visible;
    gap: var(--sp-3);
  }
}

.logo-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46px;
  padding-inline: var(--sp-6);
  min-width: 130px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  transition: border-color var(--t), box-shadow var(--t);
}

.logo-item:hover {
  border-color: var(--accent);
  box-shadow: 0 2px 10px rgba(139, 104, 48, 0.1);
}

.logo-name {
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text-muted);
  white-space: nowrap;
}

/* ── Rule ────────────────────────────────────────────────── */
.band-rule { margin-block: var(--sp-8); }

/* ── Chip row ────────────────────────────────────────────── */
.chip-row {
  margin-inline: calc(-1 * var(--sp-6));
  padding-inline: var(--sp-6);
  padding-bottom: var(--sp-1);
  gap: var(--sp-2);
}

@media (min-width: 640px) {
  .chip-row {
    margin-inline: 0;
    padding-inline: 0;
    flex-wrap: wrap;
    overflow-x: visible;
  }
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 0.5rem 1rem;
  border-radius: var(--r-pill);
  border: 1.5px solid var(--border);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text);
  background: var(--surface);
  white-space: nowrap;
  transition: background var(--t), border-color var(--t), color var(--t);
}

.chip:hover,
.chip--on {
  background: var(--accent-subtle);
  border-color: var(--accent);
  color: var(--accent);
}
</style>
