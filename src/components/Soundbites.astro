---
import { soundbites } from '../data/content.js';
---

<section class="soundbites" aria-label="Sharon Milone quotes">

  {soundbites.quotes.map((q, i) => (
    <div class={`sb-row ${i % 2 !== 0 ? 'sb-row--alt' : ''}`}>
      <div class="container">
        <blockquote class={`sb-quote reveal`} aria-label="Quote">
          <span class="sb-mark" aria-hidden="true">&ldquo;</span>
          <p class="sb-text">{q.text}</p>
          {q.attribution && (
            <footer class="sb-attr">
              <cite>{q.attribution}</cite>
            </footer>
          )}
        </blockquote>
      </div>
    </div>
  ))}

</section>

<style>
/* ── Row variants ────────────────────────────────────────── */
.sb-row {
  background: var(--earth);
  padding-block: var(--sp-16);
}

.sb-row--alt {
  background: var(--earth-alt);
}

@media (min-width: 640px) {
  .sb-row        { padding-block: var(--sp-20); }
  .sb-row--alt   { padding-block: var(--sp-20); }
}

/* ── Quote block ─────────────────────────────────────────── */
.sb-quote {
  max-width: 860px;
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.sb-row--alt .sb-quote {
  margin-left: auto;
  text-align: right;
}

/* ── Opening mark ────────────────────────────────────────── */
.sb-mark {
  display: block;
  font-family: var(--serif);
  font-size: clamp(4rem, 8vw, 7rem);
  line-height: 0.55;
  color: rgba(255, 255, 255, 0.07);
  user-select: none;
}

/* ── Quote text ──────────────────────────────────────────── */
.sb-text {
  font-family: var(--serif);
  font-style: italic;
  font-size: clamp(1.5rem, 4vw, 3rem);
  line-height: 1.3;
  color: #fff;
  letter-spacing: -0.01em;
}

/* Attribution */
.sb-attr {
  margin-top: var(--sp-3);
  font-size: 0.875rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.35);
  font-style: normal;
}

.sb-attr cite { font-style: normal; }
</style>
