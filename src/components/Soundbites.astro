---
import { soundbites } from '../data/content.js';
---

<section class="soundbites" aria-label="Sharon Milone quotes">

  {soundbites.quotes.map((q, i) => (
    <div class={`soundbite-row ${i % 2 === 1 ? 'soundbite-row--alt' : ''}`}>
      <div class="container">
        <blockquote class="soundbite reveal" aria-label="Quote">
          <span class="quote-mark" aria-hidden="true">&ldquo;</span>
          <p class="quote-text">{q.text}</p>
          {q.attribution && (
            <footer class="quote-attr"><cite>{q.attribution}</cite></footer>
          )}
        </blockquote>
      </div>
    </div>
  ))}

</section>

<style>
  /* ── Section layout ──────────────────────────────────────────── */
  .soundbites {
    /* No section padding here — rows handle their own */
  }

  /* ── Row variants ────────────────────────────────────────────── */
  .soundbite-row {
    background: var(--color-accent-earth);     /* deep earthy green — set by CSS var in global */
    padding-block: var(--sp-16);
  }

  .soundbite-row--alt {
    background: var(--color-accent-earth-dark); /* slightly darker variation */
  }

  @media (min-width: 768px) {
    .soundbite-row { padding-block: var(--sp-20); }
  }

  /* ── Quote block ─────────────────────────────────────────────── */
  .soundbite {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .soundbite-row--alt .soundbite {
    margin-left: auto;
    text-align: right;
  }

  /* ── Quote mark ──────────────────────────────────────────────── */
  .quote-mark {
    font-family: var(--font-serif);
    font-size: 5rem;
    line-height: 0.5;
    color: rgba(255,255,255,0.2);
    display: block;
    user-select: none;
  }

  /* ── Quote text ──────────────────────────────────────────────── */
  .quote-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    line-height: 1.3;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .quote-attr {
    margin-top: var(--sp-3);
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255,255,255,0.45);
  }

  .quote-attr cite { font-style: normal; }
</style>
