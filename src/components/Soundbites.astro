---
import { soundbites } from '../data/content.js';
---

<section class="soundbites" aria-label="Sharon Milone quotes">
  <div class="container">
    {soundbites.quotes.map((q, i) => (
      <blockquote
        class={`soundbite ${i % 2 === 1 ? 'soundbite--right' : ''} reveal`}
        aria-label="Quote"
      >
        <p class="soundbite-text">{q.text}</p>
        {q.attribution && (
          <footer class="soundbite-attr">
            <cite>{q.attribution}</cite>
          </footer>
        )}
      </blockquote>
    ))}
  </div>
</section>

<style>
  .soundbites {
    background: var(--color-dark);
    padding-block: var(--sp-20);
  }

  @media (min-width: 768px) {
    .soundbites {
      padding-block: var(--sp-24);
    }
  }

  /* ── Individual soundbite ────────────────────────────────────── */
  .soundbite {
    padding-block: var(--sp-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    max-width: 860px;
  }

  .soundbite:first-child {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .soundbite--right {
    margin-left: auto;
    text-align: right;
  }

  .soundbite-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);
    line-height: 1.3;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .soundbite-text::before {
    content: '\201C';
    color: var(--color-accent);
  }

  .soundbite-text::after {
    content: '\201D';
    color: var(--color-accent);
  }

  .soundbite-attr {
    margin-top: var(--sp-4);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-dark-muted);
    font-style: normal;
  }

  .soundbite-attr cite { font-style: normal; }
</style>
