---
import { whatIBuild } from '../data/content.js';
---

<section class="section what-i-build" id="work" aria-labelledby="work-heading">
  <div class="container">

    <header class="section-header reveal">
      <p class="section-eyebrow">Work</p>
      <h2 class="section-heading" id="work-heading">
        <span class="hl hl-light">What I</span>
        <span class="hl hl-heavy">Build.</span>
      </h2>
      <p class="section-subhead">{whatIBuild.subhead}</p>
    </header>

    <div class="pillars">
      {whatIBuild.pillars.map((pillar, i) => (
        <article
          class={`pillar reveal reveal-delay-${i + 1}`}
          aria-labelledby={`pillar-${i}`}
        >
          <div class="pillar-top">
            <span class="pillar-num" aria-hidden="true">0{i + 1}</span>
            <h3 class="pillar-label" id={`pillar-${i}`}>{pillar.label}</h3>
            <p class="pillar-desc">{pillar.description}</p>
          </div>
          <ul class="pillar-examples" aria-label={`${pillar.label} examples`}>
            {pillar.examples.map((ex) => (
              <li class="example-item">
                <span class="example-dot" aria-hidden="true"></span>
                <span>{ex}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .what-i-build {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .section-header { margin-bottom: var(--sp-12); }

  /* ── Pillars grid ────────────────────────────────────────────── */
  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
  }

  @media (min-width: 768px) {
    .pillars { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Single pillar ───────────────────────────────────────────── */
  .pillar {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--ease), transform var(--ease);
  }

  .pillar:hover {
    box-shadow: 0 12px 40px rgba(28,26,23,0.08);
    transform: translateY(-3px);
  }

  /* Top block — accent bar on hover */
  .pillar-top {
    padding: var(--sp-8);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .pillar-top::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 300ms ease;
    border-radius: 0 0 0 var(--radius-lg);
  }

  .pillar:hover .pillar-top::before { transform: scaleY(1); }

  .pillar-num {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .pillar-label {
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .pillar-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* ── Examples ────────────────────────────────────────────────── */
  .pillar-examples {
    padding: var(--sp-6) var(--sp-8) var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    flex: 1;
  }

  .example-item {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: var(--sp-3);
    align-items: start;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .example-dot {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-top: 0.52em;
    flex-shrink: 0;
  }
</style>
