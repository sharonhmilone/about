---
import { whatToExpect } from '../data/content.js';
---

<section class="section expect" id="expect" aria-labelledby="expect-h">
  <div class="container">

    <header class="expect-header reveal">
      <p class="eyebrow eyebrow-bronze">{whatToExpect.eyebrow}</p>
      <h2 class="s-heading" id="expect-h">
        <span class="hl hl-thin">What to</span>
        <span class="hl hl-heavy">Expect.</span>
      </h2>
      <p class="s-sub">{whatToExpect.subhead}</p>
    </header>

    <ul class="traits" aria-label="Working traits">
      {whatToExpect.traits.map((t, i) => (
        <li class={`trait reveal d${(i % 3) + 1}`}>
          <span class="trait-num" aria-hidden="true">0{i + 1}</span>
          <div class="trait-body">
            <strong class="trait-label">{t.label}</strong>
            <span class="trait-desc">{t.description}</span>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
/* ── Section ─────────────────────────────────────────────── */
.expect {
  background: var(--cream);
  border-top: 1px solid var(--border);
}

.expect-header { margin-bottom: var(--sp-12); }

/* ─────────────────────────────────────────────────────────
   TRAITS
   Mobile:  stacked list
   Tablet (640px+): 2-column
───────────────────────────────────────────────────────── */
.traits {
  display: grid;
  grid-template-columns: 1fr;
}

@media (min-width: 640px) {
  .traits { grid-template-columns: 1fr 1fr; }
}

/* ── Single trait ────────────────────────────────────────── */
.trait {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-5);
  padding-block: var(--sp-6);
  border-bottom: 1px solid var(--border);
  transition: border-color var(--t);
}

@media (min-width: 640px) {
  /* Remove bottom border from last row */
  .trait:nth-last-child(-n+2) { border-bottom: none; }
}

@media (max-width: 639px) {
  .trait:last-child { border-bottom: none; }
}

.trait:hover { border-color: var(--accent); }

.trait-num {
  font-size: 0.625rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  min-width: 28px;
  padding-top: 3px;
  flex-shrink: 0;
}

.trait-body {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.trait-label {
  display: block;
  font-size: 1.0625rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
}

.trait-desc {
  font-size: 0.9375rem;
  color: var(--text-muted);
  line-height: 1.65;
}
</style>
