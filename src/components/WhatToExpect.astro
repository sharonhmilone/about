---
import { whatToExpect } from '../data/content.js';
---

<section class="section what-to-expect" id="expect" aria-labelledby="expect-heading">
  <div class="container">

    <header class="section-header reveal">
      <p class="section-eyebrow eyebrow-dark">For hiring managers</p>
      <h2 class="section-heading" id="expect-heading" style="color:#fff;">
        <span class="hl hl-light" style="color:rgba(255,255,255,0.45)">What to</span>
        <span class="hl hl-heavy" style="color:#fff;">Expect.</span>
      </h2>
      <p class="section-subhead section-subhead--light">{whatToExpect.subhead}</p>
    </header>

    <ul class="traits" aria-label="Working traits">
      {whatToExpect.traits.map((trait, i) => (
        <li class={`trait reveal reveal-delay-${(i % 3) + 1}`}>
          <span class="trait-index" aria-hidden="true">0{i + 1}</span>
          <div class="trait-body">
            <strong class="trait-label">{trait.label}</strong>
            <span class="trait-desc">{trait.description}</span>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .what-to-expect {
    background: var(--color-dark-bg);
    border-top: 1px solid var(--color-dark-border);
  }

  .section-header { margin-bottom: var(--sp-12); }

  /* ── Traits ──────────────────────────────────────────────────── */
  .traits {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 640px) {
    .traits { grid-template-columns: 1fr 1fr; }
  }

  .trait {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-6);
    padding: var(--sp-7) 0;
    border-bottom: 1px solid var(--color-dark-border);
    transition: border-color var(--ease);
  }

  .trait:hover { border-color: rgba(255,255,255,0.15); }

  @media (min-width: 640px) {
    .trait:nth-last-child(-n+2) { border-bottom: none; }
  }

  @media (max-width: 639px) {
    .trait:last-child { border-bottom: none; }
  }

  .trait-index {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    min-width: 28px;
    padding-top: 3px;
  }

  .trait-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .trait-label {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    display: block;
  }

  .trait-desc {
    font-size: 0.9375rem;
    color: var(--color-dark-muted);
    line-height: 1.6;
  }
</style>
