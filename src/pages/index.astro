---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import HowIThink from '../components/HowIThink.astro';
import WatchMeThink from '../components/WatchMeThink.astro';
import Soundbites from '../components/Soundbites.astro';
import WhatIBuild from '../components/WhatIBuild.astro';
import WhatToExpect from '../components/WhatToExpect.astro';
import CTAFooter from '../components/CTAFooter.astro';
---

<Layout>
  <Header />
  <main id="main-content">
    <Hero />
    <ProofStrip />
    <HowIThink />
    <WatchMeThink />
    <Soundbites />
    <WhatIBuild />
    <WhatToExpect />
  </main>
  <CTAFooter />
</Layout>
